// Units of measure: the compiler tracks physical dimensions, so mixing up
// meters and seconds is a compile-time error rather than a silent bug.
unit m;
unit s;
unit kg;
unit N = <kg*m/s^2>;
unit J = <N*m>;

struct Vec2 { x: float<m>, y: float<m> }
struct Projectile { pos: Vec2, vx: float<m/s>, vy: float<m/s>, mass: float<kg> }

// Unit-polymorphic helpers: 'u is inferred at each call site.
fn square(x: float<'u>) -> float<'u^2> { return x * x; }
fn hypot(a: float<'u>, b: float<'u>) -> float<'u> { return sqrt(square(a) + square(b)); }

fn kinetic_energy(p: Projectile) -> float<J> {
    return 0.5 * p.mass * (square(p.vx) + square(p.vy));
}

// Simulates a projectile with explicit Euler steps until it lands.
fn simulate(var p: Projectile, g: float<m/s^2>, dt: float<s>) -> Projectile {
    while p.pos.y >= 0.0<m> {
        p.pos.x += p.vx * dt;
        p.pos.y += p.vy * dt;
        p.vy -= g * dt;
    }
    return p;
}

fn main() {
    let g = 9.81<m/s^2>;
    let start = Projectile(pos: Vec2(x: 0.0<m>, y: 0.0<m>), vx: 30.0<m/s>, vy: 40.0<m/s>, mass: 0.145<kg>);

    print("launch speed:");
    hypot(start.vx, start.vy) |> print;           // 50 m/s

    print("launch energy:");
    kinetic_energy(start) |> print;               // in kg*m^2/s^2 (joules)

    let landed = simulate(start, g, 0.001<s>);
    print("range:");
    print(landed.pos.x);

    let flight_time = 2.0 * start.vy / g;         // inferred as float<s>
    print("analytic flight time:");
    print(flight_time);

    let w: float<N> = start.mass * g;             // N expands to kg*m/s^2
    print("weight:");
    print(w);

    // Uncomment any of these to see the unit checker reject it:
    // let oops = flight_time + landed.pos.x;     // float<s> + float<m>
    // let bad = sqrt(landed.pos.x);              // m has no exact square root
    // let e: float<J> = start.mass * start.vx;   // kg*m/s is momentum, not energy
}
