// Recursive and iterative Fibonacci.
fn fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fib_iter(n: int) -> int {
    var a = 0;
    var b = 1;
    for i in 0..n {
        let next = a + b;
        a = b;
        b = next;
    }
    return a;
}

fn main() -> int {
    print("fib(20) recursive:");
    print(fib(20));
    print("fib(50) iterative:");
    print(fib_iter(50));
    return 0;
}
