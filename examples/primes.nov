// Prints every prime below 100 and how many there are.
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false;
    }
    var d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() -> int {
    var count = 0;
    for n in 0..100 {
        if is_prime(n) {
            print(n);
            count = count + 1;
        }
    }
    print("total:");
    print(count);
    return 0;
}
