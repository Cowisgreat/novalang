// expect: 15
fn is_prime(n: int) -> bool {
    var d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d = d + 1;
    }
    return true;
}
fn main() -> int {
    var count = 0;
    for n in 2..50 {
        if is_prime(n) { count = count + 1; }
    }
    print(count);
    return 0;
}
