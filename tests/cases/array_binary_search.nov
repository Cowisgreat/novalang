// expect: 3
// expect: -1
fn find(xs: [int], target: int) -> int {
    var lo = 0;
    var hi = len(xs) - 1;
    while lo <= hi {
        let mid = (lo + hi) / 2;
        if xs[mid] == target { return mid; }
        if xs[mid] < target { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}
fn main() -> int {
    let a = [1, 3, 5, 7, 9, 11];
    print(find(a, 7));
    print(find(a, 4));
    return 0;
}
