// expect: 10
fn main() -> int {
    let n = 30;
    var composite = [false; n];
    var count = 0;
    for i in 2..n {
        if !composite[i] {
            count += 1;
            var j = i * i;
            while j < n {
                composite[j] = true;
                j += i;
            }
        }
    }
    print(count);
    return 0;
}
